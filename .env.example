# Server Configuration
PORT=3000

# Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_database_password
DB_NAME=dermo_reminder_system

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
